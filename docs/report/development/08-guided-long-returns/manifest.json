  "post_round_diagnostics": [
    {
      "date": "2026-11-21",
      "title": "Training and baseline diagnostic",
      "pi_input": "The PI asked for loss and reward trends and for the dimensions where DQN and PPO underperformed Random or ACO.",
      "agent_findings": "ACO led on all four layouts, with the largest coverage and waiting gaps on C and D. DQN loss fell even where reward declined, particularly on D. PPO value loss fell while training rewards mostly plateaued. On the 12 matched test shifts, sampling instead of choosing PPO’s most probable action recovered the collapsed scratch checkpoint from 1 to 83 served visits on C and from 8 to 185 on D.",
      "time": "2026-11-21T16:09:27+00:00"
    },
    {
      "date": "2026-11-21",
      "title": "Observation and return diagnostic",
      "pi_input": "The PI asked whether agents could see elapsed and remaining shift time, the full unserved pool, the nurse roster and individual release times, and whether the return targets reached far enough ahead.",
      "agent_findings": "The agents saw the clock and every job’s status, plus details of the current nurse and the aggregate busy fraction. Other nurses’ assignments, queue positions and release forecasts were absent. Across the three DQN variants on D, seed 11’s 16-decision targets covered a median of 17–27 simulated minutes and only 55–59% of eventually completed visits finished within their assignment’s direct target. PPO included shift end in about 70% of decisions in completed training shifts on D and 89–90% on A–C.",
      "time": "2026-11-21T16:21:59+00:00"
    }
